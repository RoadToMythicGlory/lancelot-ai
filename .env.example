# Lancelot — docker-compose environment
# Copy to `.env` and fill in. Never commit `.env`.

# MongoDB root credentials (created on first start)
MONGO_USERNAME=lancelot
MONGO_PASSWORD=

# JWT signing secret — generate with:  openssl rand -base64 64
JWT_SECRET=

# Where the browser reaches the API (change for remote hosts)
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:4000/graphql

# AI copilot (optional) — Ollama running on the host
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_PRIMARY_MODEL=aya-expanse:8b
LLM_HEBREW_MODEL=aya-expanse:8b

# Grafana admin
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=
