# Production Dockerfile for Lancelot Platform
# This file ensures all services use api.lanceloterp.io instead of localhost:4000

# Base image with Node.js
FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY package*.json ./
COPY turbo.json ./
COPY apps/web/package*.json ./apps/web/
COPY services/api-gateway/package*.json ./services/api-gateway/
COPY services/routing-engine/package*.json ./services/routing-engine/
COPY services/excel-parser/package*.json ./services/excel-parser/
COPY packages/*/package*.json ./packages/

RUN npm ci

# Build the application
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Set production environment variables for build
ENV NODE_ENV=production
ENV NEXT_PUBLIC_GRAPHQL_URL=https://api.lanceloterp.io/graphql
ENV NEXT_PUBLIC_WS_URL=wss://api.lanceloterp.io/graphql
ENV NEXT_PUBLIC_API_URL=https://api.lanceloterp.io
ENV NEXT_PUBLIC_CHAT_WS_URL=https://api.lanceloterp.io

# Build all packages
RUN npm run build

# Production image for web app
FROM base AS web-runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Production URLs
ENV NEXT_PUBLIC_GRAPHQL_URL=https://api.lanceloterp.io/graphql
ENV NEXT_PUBLIC_WS_URL=wss://api.lanceloterp.io/graphql
ENV NEXT_PUBLIC_API_URL=https://api.lanceloterp.io
ENV NEXT_PUBLIC_CHAT_WS_URL=https://api.lanceloterp.io

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy built application
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

# Copy locales
COPY --from=builder /app/apps/web/public/locales ./apps/web/public/locales

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "apps/web/server.js"]

# Production image for API Gateway
FROM base AS api-gateway-runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nodejs

# Copy built application
COPY --from=builder /app/services/api-gateway/dist ./dist
COPY --from=builder /app/services/api-gateway/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

USER nodejs

EXPOSE 4000

CMD ["node", "dist/index.js"]

# Production image for Routing Engine
FROM base AS routing-engine-runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nodejs

# Copy built application
COPY --from=builder /app/services/routing-engine/dist ./dist
COPY --from=builder /app/services/routing-engine/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

USER nodejs

EXPOSE 4001

CMD ["node", "dist/main.js"]

# Production image for Excel Parser
FROM base AS excel-parser-runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nodejs

# Copy built application
COPY --from=builder /app/services/excel-parser/dist ./dist
COPY --from=builder /app/services/excel-parser/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

USER nodejs

EXPOSE 4002

CMD ["node", "dist/main.js"]
