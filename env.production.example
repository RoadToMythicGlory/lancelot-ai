# Production Environment Variables Example

## API Gateway Variables
NODE_ENV=production
API_PORT=4000

# MongoDB Atlas Configuration
MONGODB_URL=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/lancelot?retryWrites=true&w=majority
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_DATABASE=lancelot

# Security
# REQUIRED in production. Generate locally with `openssl rand -base64 64`.
# Never reuse the JWT_SECRET that was previously shipped in this file — rotate it.
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS - Update with your actual domain
CORS_ORIGIN=https://lanceloterp.io
CORS_ALLOWED_ORIGINS=https://lanceloterp.io,https://www.lanceloterp.io
CORS_ALLOW_CREDENTIALS=true

## Frontend Variables
NEXT_PUBLIC_GRAPHQL_URL=https://api.lanceloterp.io/graphql
NEXT_PUBLIC_WS_URL=wss://api.lanceloterp.io/graphql
NEXT_PUBLIC_API_URL=https://api.lanceloterp.io
NEXT_PUBLIC_CHAT_WS_URL=https://api.lanceloterp.io

# Application Settings
NEXT_PUBLIC_APP_NAME=Lancelot Platform
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Features
NEXT_PUBLIC_ENABLE_EXCEL_IMPORT=true
NEXT_PUBLIC_ENABLE_BARCODE_SCANNER=true
ENABLE_GRAPHQL_PLAYGROUND=false
ENABLE_GRAPHQL_INTROSPECTION=false

# Locale
DEFAULT_LOCALE=he
NEXT_PUBLIC_DEFAULT_LOCALE=he
TIMEZONE=Asia/Jerusalem
NEXT_PUBLIC_TIMEZONE=Asia/Jerusalem

## External Partner API (Shared Engineering Equipment)
# See docs/external-api/shared-engineering-equipment.md for the full spec.

# Comma-separated list of API keys accepted on /api/v1/external/* endpoints.
# Generate each key with `openssl rand -hex 32`. Rotate by issuing a new key,
# updating the partner dashboard, then removing the old key.
VALID_API_KEYS=

# Per-key request budget for /api/v1/external/*. Default: 120/min.
EXTERNAL_API_RATE_LIMIT_PER_MIN=120

# Base URL used to build absolute `_links` inside outbound webhook payloads
# (the REST handlers infer this from the request itself). Example:
# https://api.lanceloterp.io
EXTERNAL_API_BASE_URL=

# Outbound webhook delivery — POSTs `equipment.*` events to the partner.
EXTERNAL_WEBHOOK_ENABLED=false
EXTERNAL_WEBHOOK_URL=
# Generate with `openssl rand -hex 32`. Signs every POST with HMAC-SHA256;
# the partner verifies via the X-Lancelot-Signature header (see docs).
EXTERNAL_WEBHOOK_SECRET=
# Per-attempt HTTP timeout (ms). Default 15s.
EXTERNAL_WEBHOOK_TIMEOUT_MS=15000
# How often the retry worker sweeps for due retries (ms). Default 15s.
EXTERNAL_WEBHOOK_RETRY_INTERVAL_MS=15000
# Minimum time between `equipment.location.changed` pushes for the same
# tracker. Prevents partners from being flooded by BLE readings. Default 60s.
EXTERNAL_WEBHOOK_LOCATION_DEBOUNCE_MS=60000





















