# =============================================================================
# Lancelot API Gateway — Environment Variables
# =============================================================================
# Copy to `.env` for local dev or `.env.production` for production deployments.
# NEVER commit real secrets. Production deployments MUST set every value below
# that is marked REQUIRED — defaults that ship with the codebase are intentional
# only for local development.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
# REQUIRED in production. One of: development | staging | production
NODE_ENV=development
PORT=4000

# --- MongoDB ----------------------------------------------------------------
# Either provide a full connection string OR provide MONGO_HOST/USERNAME/PASSWORD.
# In production the API will refuse to start without explicit credentials.
#
# Supported variable names (canonical first, runtime aliases follow):
#   MONGODB_URL   - full connection string consumed by the api-gateway runtime
#                   (services/api-gateway/src/config/mongodb.ts) and by
#                   docker-compose for the ai-agent container.
#   MONGODB_URI   - alias used by some bootstrap scripts (e.g. add-mcr-user.js)
#                   and the api-gateway service block in docker-compose.yml.
#                   When you set one, mirror it to the other unless you only
#                   use one of those entrypoints.
#   MONGO_USERNAME / MONGO_PASSWORD - preferred for local dev; combined with
#                   MONGO_HOST / MONGO_PORT / MONGO_DATABASE the runtime will
#                   build the URL itself.
# MONGODB_URL=mongodb://user:pass@host:27017/lancelot?authSource=admin
# MONGODB_URI=mongodb://user:pass@host:27017/lancelot?authSource=admin
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=lancelot
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# --- Redis (optional) -------------------------------------------------------
# Leave empty in production to disable Redis usage entirely.
REDIS_URL=redis://localhost:6379

# --- JWT --------------------------------------------------------------------
# REQUIRED in production. Use `node services/api-gateway/src/scripts/generate-jwt-secret.ts`
# or `openssl rand -base64 64` to generate a strong secret. Minimum 64 chars in production.
JWT_SECRET=
# Optional: set when rotating secrets so old tokens still verify.
JWT_SECRET_PREVIOUS=
JWT_SECRET_ROTATION_DATE=
JWT_SECRET_VERSION=1
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Session / CSRF (REQUIRED in production) -------------------------------
SESSION_SECRET=
CSRF_SECRET=

# --- CORS -------------------------------------------------------------------
# Comma-separated list. In production this MUST be set explicitly; the defaults
# only apply to development.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5

# --- Microsoft Graph / OAuth -----------------------------------------------
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Vendor APIs (optional, set what you use) ------------------------------
LIVEU_API_KEY=
LIVEU_API_URL=https://api.liveu.tv/v1
VMIX_API_KEY=
VMIX_API_URL=http://localhost:8088/api
MAGNUM_API_KEY=
MAGNUM_API_URL=https://api.magnum.tv/v1
UNITY_API_KEY=
UNITY_API_URL=https://api.unity.com/v1

# --- Email (optional) -------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Lancelot Platform <noreply@example.com>

# --- Feature flags ----------------------------------------------------------
ENABLE_EXCEL_IMPORT=true
ENABLE_BARCODE_SCANNER=true
ENABLE_VOICE_COMMANDS=false
ENABLE_AR_OVERLAY=false
ENABLE_E2EE_CHAT=true

# --- Locale -----------------------------------------------------------------
DEFAULT_LOCALE=he
FALLBACK_LOCALE=en
TIMEZONE=Asia/Jerusalem

# --- Debug ------------------------------------------------------------------
# All MUST remain false in production.
DEBUG_SQL=false
DEBUG_GRAPHQL=false
DEBUG_PERMISSIONS=false

# --- Dev-only auth shortcuts ------------------------------------------------
# This MUST stay unset (or 0) in production. When set to "1" in non-production
# environments, the password "test123" is accepted for any user.
ALLOW_DEV_PASSWORD=0

# --- Microservices ----------------------------------------------------------
EXCEL_PARSER_URL=http://localhost:3002
ROUTING_ENGINE_URL=http://localhost:5002

# --- Grafana (used by docker-compose) --------------------------------------
# REQUIRED if you start the grafana service. Compose refuses to boot with the
# upstream `admin/admin` defaults.
GRAFANA_ADMIN_USER=
GRAFANA_PASSWORD=

# --- MCR bootstrap script (services/api-gateway/add-mcr-user.js) -----------
# Only needed when you actually run the script. Rotate the password after use.
MCR_USER_EMAIL=
MCR_USER_PASSWORD=
MCR_USER_FIRST_NAME=
MCR_USER_LAST_NAME=
MCR_DEPARTMENT_CODE=MCR-General

# --- BLE Tracking (MQTT) ----------------------------------------------------
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=lancelot/tracking
TRACKING_RETENTION_DAYS=30
TRACKING_STALE_THRESHOLD_SECONDS=300
ENABLE_TRACKING=true
