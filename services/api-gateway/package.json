{
  "name": "@lancelot/api-gateway",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/index.ts",
    "start:dev": "ts-node src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs');const path=require('path');const src='src/schema';const out='dist/schema';fs.mkdirSync(out,{recursive:true});for(const f of fs.readdirSync(src)){if(f.endsWith('.graphql')){fs.copyFileSync(path.join(src,f),path.join(out,f));}}\"",
    "start": "NODE_ENV=production node server.js",
    "start:dist": "node dist/index.js",
    "test": "jest",
    "migrate:broadcast": "ts-node src/scripts/migrate-broadcast-to-mongodb.ts",
    "migrate:permissions": "ts-node src/scripts/migrate-to-simple-permissions.ts",
    "migrate-passwords": "ts-node src/scripts/migrate-passwords.ts",
    "migrate:users": "ts-node src/scripts/migrate-users-to-hierarchical.ts",
    "seed:users": "ts-node src/scripts/seed-users.ts",
    "seed:help": "ts-node src/scripts/seed-help-articles.ts",
    "seed:departments-users": "ts-node src/scripts/seed-departments-users.ts",
    "seed:department-users": "ts-node src/scripts/seed-department-users.ts",
    "seed:assignment-form-configs": "ts-node src/scripts/seed-assignment-form-configs.ts",
    "seed:production-mcr": "cross-env NODE_ENV=production ts-node src/scripts/seed-production-mcr-admin.ts",
    "fix:mcr-permissions": "cross-env NODE_ENV=production ts-node src/scripts/fix-mcr-admin-permissions.ts",
    "test:production-db": "cross-env NODE_ENV=production ts-node src/scripts/test-production-connection.ts",
    "generate:service-jwt": "ts-node src/scripts/generate-service-jwt.ts",
    "repair:equipment": "ts-node src/scripts/repair-equipment-orphans.ts",
    "repair:equipment:apply": "ts-node src/scripts/repair-equipment-orphans.ts --apply",
    "repair:equipment:apply:canon": "ts-node src/scripts/repair-equipment-orphans.ts --apply --restore-canon-c300"
  },
  "dependencies": {
    "@apollo/client": "^4.0.4",
    "@apollo/server": "^4.9.0",
    "@graphql-tools/schema": "^10.0.23",
    "@types/ws": "^8.18.1",
    "apollo-server-express": "^3.13.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.11",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "fastest-levenshtein": "^1.0.16",
    "graphql": "^16.6.0",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "^6.0.5",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.1",
    "mqtt": "^5.15.1",
    "multer": "^2.1.1",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.11.0",
    "rate-limit-redis": "^4.2.1",
    "socket.io": "^4.6.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^18.14.6",
    "@types/pg": "^8.10.0",
    "@types/uuid": "^9.0.7",
    "cross-env": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.2.0"
  }
}
